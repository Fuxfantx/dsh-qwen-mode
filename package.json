{
  "name": "dsh-qwen-mode",
  "version": "1.8.2",
  "description": "Qwen, GenieX, and QwenCloud providers for DSH with thinking, sampling, warmup, MTP, and per-turn statistics.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "author": "Fuxfantx",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fuxfantx/dsh-qwen-mode.git"
  },
  "homepage": "https://github.com/Fuxfantx/dsh-qwen-mode#readme",
  "bugs": {
    "url": "https://github.com/Fuxfantx/dsh-qwen-mode/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qwen",
    "geniex",
    "local-llm",
    "openai-compatible",
    "cordis-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
